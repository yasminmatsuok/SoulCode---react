# Copie este arquivo para .env (o .env NÃO vai para o GitHub).

# URL base da API Java (Spring Boot, publicada no Render), sem barra no final.
VITE_API_URL=https://soulcode-api.onrender.com

# Vale só para missões, recompensas, conversões e saldo (ainda sem rotas na API Java).
# Usuários e avatares sempre usam a API real.
# true  = usa os dados mockados de src/mocks
# false = chama a API real em VITE_API_URL
VITE_USE_MOCK=true

# Id do usuário logado (o projeto ainda não tem login)
VITE_USUARIO_ID=1

# Só para o mock: chance de erro simulado entre 0 e 1 (ex.: 0.2 = 20%)
VITE_MOCK_ERROR_RATE=0
